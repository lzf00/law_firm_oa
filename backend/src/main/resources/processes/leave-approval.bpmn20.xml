<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="https://zoro.example/law-oa">
    <process id="leaveApproval" name="请假审批" isExecutable="true">
        <startEvent id="start" name="提交请假"/>
        <sequenceFlow id="flow1" sourceRef="start" targetRef="managerApproval"/>
        <userTask id="managerApproval" name="负责人审批"
                  flowable:candidateGroups="MANAGING_PARTNER"/>
        <sequenceFlow id="flow2" sourceRef="managerApproval" targetRef="hrRecord"/>
        <userTask id="hrRecord" name="人事复核与登记"
                  flowable:candidateGroups="HR"/>
        <sequenceFlow id="flow3" sourceRef="hrRecord" targetRef="end"/>
        <endEvent id="end" name="审批通过"/>
    </process>
</definitions>
